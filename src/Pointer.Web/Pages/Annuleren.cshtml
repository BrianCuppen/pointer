@page "/annuleren/{token}"
@model Pointer.Web.Pages.AnnulerenModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T
@using Pointer.Core.Domain
@{
    ViewData["Title"] = T["CancelPage_Title"];
    ViewData["Narrow"] = true;
    ViewData["BarShop"] = Model.ShopName;
    var start = Model.Local(Model.Booking.StartUtc);
}
<section class="result">
    @if (Model.Done)
    {
        <div class="result-icon neutral">@Icon.Svg("calendar-x")</div>
        <h1>@T["CancelPage_Title"]</h1>
        <p class="lead" role="status">@T["CancelPage_Done"]</p>
    }
    else
    {
        <div class="result-icon neutral">@Icon.Svg("calendar")</div>
        <h1>@T["CancelPage_Title"]</h1>
        <p class="lead">@T["CancelPage_Question"]</p>
    }
    <div class="card ticket">
        <div class="ticket-row">
            <span class="icon-box">@Icon.Svg("scissors")</span>
            <div><div class="k">@Model.ShopName</div><div class="v">@Model.Booking.Service!.Name</div></div>
        </div>
        <div class="ticket-row">
            <span class="icon-box">@Icon.Svg("calendar")</span>
            <div><div class="k">@T["Book_When"]</div><div class="v">@start.ToString("dddd d MMMM yyyy") @T["Book_At"] @start.ToString("HH:mm")</div></div>
        </div>
    </div>

    @if (!Model.Done)
    {
        @if (!Model.CanCancel)
        {
            <div class="alert alert-info" style="margin-top:18px;text-align:left">@Icon.Svg("info") <p>@T["CancelPage_NotPossible"]</p></div>
        }
        else
        {
            @if (Model.HasDeposit)
            {
                <div class="alert @(Model.WouldRefund ? "alert-ok" : "alert-warn")" style="margin-top:18px;text-align:left">
                    @Icon.Svg(Model.WouldRefund ? "check-circle" : "alert")
                    <p>@(Model.WouldRefund ? T["CancelPage_Refund", Money.Format(Model.Booking.DepositCents)] : T["CancelPage_NoRefund", Money.Format(Model.Booking.DepositCents)])</p>
                </div>
            }
            <form method="post" class="result-actions">
                <button type="submit" class="btn btn-dark btn-lg">@T["CancelPage_Submit"]</button>
            </form>
        }
    }
</section>
