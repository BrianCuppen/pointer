@model Pointer.Core.Domain.Shop
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T
<header class="shop-hero rise">
    <div class="shop-id">
        <div class="monogram" aria-hidden="true">@(Model.Name.Length > 0 ? char.ToUpperInvariant(Model.Name[0]) : 'P')</div>
        <div class="grow">
            <a asp-page="/Boeken/Index" asp-route-slug="@Model.Slug" class="shop-name" style="color:inherit;text-decoration:none">@Model.Name</a>
            <div class="shop-meta">
                @if (Model.Address is not null)
                {
                    <span>@Icon.Svg("map-pin") @Model.Address</span>
                }
                <span>@Icon.Svg("zap") @T["Book_InstantConfirm"]</span>
            </div>
        </div>
    </div>
</header>
