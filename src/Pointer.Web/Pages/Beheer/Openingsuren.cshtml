@page
@model Pointer.Web.Pages.Beheer.OpeningsurenModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Admin_Hours"];
}
<div class="page-head rise">
    <div>
        <h1>@T["Admin_Hours"]</h1>
        <p>@T["Hours_Help"]</p>
    </div>
</div>
<form method="post" class="rise rise-1" style="max-width:860px">
    <div asp-validation-summary="All" role="alert" style="margin-bottom:16px"></div>
    <div class="card">
        <ul class="hours">
            @for (var i = 0; i < Model.Days.Count; i++)
            {
                var d = Model.Days[i];
                var name = Model.DayName(d.Day);
                <li class="@(d.Opens is null ? "is-closed" : null)">
                    <div class="dayname">
                        <span style="text-transform:capitalize">@name</span>
                        <span class="badge">@T["Hours_Closed"]</span>
                        <input type="hidden" asp-for="Days[i].Day" />
                    </div>
                    <div class="ranges">
                        <div class="range">
                            <input class="input input-sm" asp-for="Days[i].Opens" type="time" aria-label="@name @T["Hours_Opens"]" />
                            <span class="sep">–</span>
                            <input class="input input-sm" asp-for="Days[i].Closes" type="time" aria-label="@name @T["Hours_Closes"]" />
                        </div>
                        <div class="range">
                            <input class="input input-sm" asp-for="Days[i].Opens2" type="time" aria-label="@name @T["Hours_Opens2"]" />
                            <span class="sep">–</span>
                            <input class="input input-sm" asp-for="Days[i].Closes2" type="time" aria-label="@name @T["Hours_Closes2"]" />
                        </div>
                    </div>
                </li>
            }
        </ul>
        <div class="card-foot row-between">
            <span class="hint">@Icon.Svg("info") @T["Hours_SecondRangeHelp"]</span>
            <button type="submit" class="btn btn-primary">@Icon.Svg("check") @T["Save"]</button>
        </div>
    </div>
</form>
