@page
@model Pointer.Web.Pages.Beheer.InloggenModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T
@inject IConfiguration Config
@{
    ViewData["Title"] = T["Login_Title"];
}
<div class="auth">
    <div class="auth-top">
        <a class="wordmark" href="/">@Icon.Mark() @T["AppName"]</a>
    </div>
    <div class="auth-form">
        <div class="auth-card rise">
            <h1>@T["Login_Title"]</h1>
            <p class="muted" style="margin-top:8px">@T["Login_Help"]</p>
            <form method="post" style="margin-top:28px">
                <div asp-validation-summary="ModelOnly" role="alert" style="margin-bottom:18px"></div>
                <div class="field">
                    <label class="label" asp-for="Email">@T["Field_Email"]</label>
                    <div class="input-group">
                        @Icon.Svg("mail")
                        <input class="input" asp-for="Email" type="email" autocomplete="username" required autofocus />
                    </div>
                </div>
                <div class="field">
                    <label class="label" asp-for="Password">@T["Field_Password"]</label>
                    <div class="input-group">
                        @Icon.Svg("lock")
                        <input class="input" asp-for="Password" type="password" autocomplete="current-password" required />
                    </div>
                </div>
                <input type="hidden" asp-for="ReturnUrl" />
                <button type="submit" class="btn btn-primary btn-lg btn-block" style="margin-top:24px">@T["Login_Submit"]</button>
            </form>
            @* Only the well-known public demo password is ever shown, never a configured one. *@
            @if (Config.GetValue<bool>("Demo:Seed") && Config["Demo:OwnerPassword"] == "demo-only-password")
            {
                <div class="demo-hint">@T["Login_DemoHint"] <code>@(Config["Demo:OwnerEmail"] ?? "demo@pointer.test")</code> · <code>demo-only-password</code></div>
            }
        </div>
    </div>
    <div class="auth-foot">@T["Login_ArtFoot"]</div>
</div>
