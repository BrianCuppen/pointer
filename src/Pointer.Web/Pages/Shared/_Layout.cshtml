@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T
<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string title ? $"{title} - " : "")@T["AppName"]</title>
    @* No styling on purpose: the visual design comes from Figma later. *@
</head>
<body>
    <main>
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
